# --- Local development -------------------------------------------------
# `npm run dev` sets DEV_AUTH=1: no Google sign-in, sample users and sample
# requests held in memory. Switch users at http://localhost:3000/dev.
# DEV_AUTH is ignored on Cloud Run, so it can never be left on in production.

# --- Production (Cloud Run) ---------------------------------------------
# Google Workspace domain people sign in with.
ORG_DOMAIN=islam1.org

# OAuth client (Google Cloud console > APIs & Services > Credentials,
# type "Web application", internal consent screen).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth: the public URL of the portal and a long random secret
# (openssl rand -base64 32). Keep the secret in Secret Manager.
NEXTAUTH_URL=https://portal.example.org
NEXTAUTH_SECRET=

# Group lookup: the Cloud Run service account is granted domain-wide
# delegation for admin.directory.group.readonly and impersonates this
# Workspace admin to read a user's groups. See docs/setup.md.
DIRECTORY_ADMIN_SUBJECT=
# Email of the service account (only needed if not inferable from ADC).
DIRECTORY_SERVICE_ACCOUNT=

# Alert emails: the mailbox the portal sends from (Gmail API, domain-wide
# delegation with gmail.send). Leave empty to keep email off; the in-portal
# notifications still work. See docs/setup.md, step 8.
PORTAL_MAIL_FROM=
# Email is only the fallback when Chat can't reach someone; "off" makes alerts Chat only.
PORTAL_EMAIL_FALLBACK=

# Google Chat alerts from the "IAR Portal" Chat app: "on" to send them.
PORTAL_CHAT=
# Who Chat's signed requests to /api/chat are addressed to. Defaults to
# NEXTAUTH_URL + /api/chat.
CHAT_AUDIENCE=

# Room calendars: the account the portal acts as to read and hold rooms.
# Defaults to PORTAL_MAIL_FROM.
PORTAL_CALENDAR_SUBJECT=

# The daily job (Cloud Scheduler): the service account allowed to call /api/daily.
DAILY_INVOKER=

# Beta: only members of this group (and portal-role-admin@) can sign in.
# Leave empty to open the portal to every @islam1.org account.
PORTAL_ACCESS_GROUP=

# Firestore: the project is taken from the Cloud Run environment.
STORE=firestore

# --- Purchase Requests ----------------------------------------------------
# Folder in the PO Records Shared Drive where receipts and invoices are filed.
# The runtime service account must be a Content manager on that Shared Drive.
PO_DRIVE_FOLDER_ID=
# Restricted W-9 Shared Drive folder (finance only).
W9_DRIVE_FOLDER_ID=
# Who approves each fund and IAR's cards are set in Portal Settings (/admin),
# not here.
# Requests at or above this many dollars need executive approval. Leave empty
# until the Shura sets the amount (no executive step).
PO_EXECUTIVE_THRESHOLD=

# --- IT & Maintenance -----------------------------------------------------
# Folder where ticket photos are filed.
MAINTENANCE_DRIVE_FOLDER_ID=
